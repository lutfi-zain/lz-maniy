{
	"name": "lz-maniy-workspace",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": ["apps/*", "packages/*"],
	"scripts": {
		"dev:web": "bun run --cwd apps/web dev",
		"dev:agent": "bun run --cwd apps/agent dev",
		"build:web": "bun run --cwd apps/web build",
		"build:agent": "bun run --cwd apps/agent build",
		"build:studio": "bun run --cwd apps/studio build",
		"dev:studio": "bun run --cwd apps/studio dev",
		"check:studio": "bun run --cwd apps/studio check",
		"test:web": "bun run --cwd apps/web test:unit",
		"test:agent": "bun run --cwd apps/agent test",
		"check:web": "bun run --cwd apps/web check",
		"check:secrets": "bun scripts/check-secrets.ts",
		"check:secrets:history": "bun scripts/check-secrets.ts --history"
	}
}
